{
  "name": "rapidocr-node",
  "type": "module",
  "version": "0.1.3",
  "packageManager": "pnpm@12.8.1",
  "description": "TypeScript OCR for Node.js, following the RapidOCR pipeline and ONNX models.",
  "author": "OSpoon",
  "license": "Apache-2.0",
  "homepage": "https://github.com/OSpoon/RapidOCRNode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSpoon/RapidOCRNode.git"
  },
  "bugs": {
    "url": "https://github.com/OSpoon/RapidOCRNode/issues"
  },
  "keywords": [
    "ocr",
    "rapidocr",
    "onnxruntime",
    "nodejs",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "rapidocr-node": "./dist/cli.mjs"
  },
  "files": [
    "LICENSE.md",
    "MODEL-LICENSES.md",
    "NOTICE.md",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "prepack": "pnpm run build",
    "release": "bumpp",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm run build && vitest run --config vitest.e2e.config.ts",
    "test:models": "pnpm run build && vitest run --config vitest.models.config.ts",
    "typecheck": "tsc --noEmit",
    "ci": "pnpm run lint && pnpm run knip && pnpm run test && pnpm run typecheck && pnpm run build",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks"
  },
  "dependencies": {
    "@techstark/opencv-js": "catalog:",
    "bidi-js": "catalog:",
    "clipper-lib": "catalog:",
    "commander": "catalog:",
    "onnxruntime-node": "catalog:",
    "p-retry": "catalog:",
    "sharp": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@types/clipper-lib": "catalog:",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "publint": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "tsdown": "catalog:cli",
    "typescript": "catalog:cli",
    "unrun": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run ci && pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  }
}
